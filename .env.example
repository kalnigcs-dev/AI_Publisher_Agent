# Database configuration
SQLITE_DB_PATH=data/publisher.db

# WordPress configuration (for testing/production)
WP_SITE_URL=https://your-site.com
WP_API_URL=https://your-site.com/wp-json/wp/v2
WP_USERNAME=publisher_agent
WP_APP_PASSWORD=your_application_password_here

# Publishing controls & guardrails
PUBLISHING_ENABLED=false
MAX_POSTS_PER_DAY=1
DRY_RUN=true

# Logging
LOG_LEVEL=INFO
